rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Mirrors the Firestore rule: admin is membership in /admins/{uid}, which no
    // client can grant itself.
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Only the images the editor actually uploads, and only images. Previously any
    // signed-in user could write any file of any size to any path, world-readable.
    match /images/{imageId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif|svg\\+xml)');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
