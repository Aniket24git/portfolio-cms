rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a user with a document at /admins/{their uid}. Create that
    // document once from the Firebase console; it needs no fields. Membership is
    // never writable from a client, so signing up cannot grant it.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The app reads and writes doc(db, 'content', 'portfolio') -> /content/portfolio.
    // The previous rule guarded /portfolio/content, a different path, so the real
    // document matched no rule at all.
    match /content/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false; // console only
    }

    // Anything not matched above stays denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
